<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/err"
            android:gravity="center"
            android:padding="10dp"
            android:text="IT / ADMIN"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Identity -->
        <TextView style="@style/AdminHeader" android:text="Scanner identity" />
        <TextView
            android:id="@+id/tvIdentity"
            style="@style/AdminBody" />

        <TextView style="@style/AdminLabel" android:text="Asset Tag (6 digits) – type or scan" />
        <EditText
            android:id="@+id/etAssetTag"
            style="@style/AdminField"
            android:inputType="number"
            android:maxLength="6" />
        <Button
            android:id="@+id/btnSaveAsset"
            style="@style/AdminButton"
            android:text="Save Asset Tag" />

        <!-- Backend -->
        <TextView style="@style/AdminHeader" android:text="Power Automate" />
        <TextView
            android:id="@+id/tvBackend"
            style="@style/AdminBody" />
        <EditText
            android:id="@+id/etEndpoint"
            style="@style/AdminField"
            android:hint="Paste new HTTP trigger URL to replace"
            android:inputType="textUri|textNoSuggestions" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSaveEndpoint"
                style="@style/AdminButtonHalf"
                android:text="Save URL" />
            <Button
                android:id="@+id/btnClearEndpoint"
                style="@style/AdminButtonHalf"
                android:text="Test mode" />
        </LinearLayout>
        <Button
            android:id="@+id/btnTestConnection"
            style="@style/AdminButton"
            android:text="Test connection" />

        <!-- Department codes -->
        <TextView style="@style/AdminHeader" android:text="QR code values" />
        <TextView style="@style/AdminLabel" android:text="INBOUND" />
        <EditText android:id="@+id/etInbound" style="@style/AdminField" android:inputType="textCapCharacters|textNoSuggestions" />
        <TextView style="@style/AdminLabel" android:text="OUTBOUND" />
        <EditText android:id="@+id/etOutbound" style="@style/AdminField" android:inputType="textCapCharacters|textNoSuggestions" />
        <TextView style="@style/AdminLabel" android:text="SHIPDOCK" />
        <EditText android:id="@+id/etShipdock" style="@style/AdminField" android:inputType="textCapCharacters|textNoSuggestions" />
        <TextView style="@style/AdminLabel" android:text="ADMIN QR" />
        <EditText android:id="@+id/etAdminCode" style="@style/AdminField" android:inputType="textCapCharacters|textNoSuggestions" />
        <Button
            android:id="@+id/btnSaveCodes"
            style="@style/AdminButton"
            android:text="Save QR values" />

        <!-- Behaviour -->
        <TextView style="@style/AdminHeader" android:text="Behaviour" />
        <TextView style="@style/AdminLabel" android:text="Duplicate-scan window (seconds)" />
        <EditText android:id="@+id/etDebounce" style="@style/AdminField" android:inputType="number" android:maxLength="3" />
        <TextView style="@style/AdminLabel" android:text="Cooldown after save, same department (seconds)" />
        <EditText android:id="@+id/etCooldown" style="@style/AdminField" android:inputType="number" android:maxLength="3" />
        <TextView style="@style/AdminLabel" android:text="Login screen timeout (seconds)" />
        <EditText android:id="@+id/etLoginTimeout" style="@style/AdminField" android:inputType="number" android:maxLength="3" />
        <TextView style="@style/AdminLabel" android:text="ICQA" />
        <EditText android:id="@+id/etIcqa" style="@style/AdminField" android:inputType="textCapCharacters|textNoSuggestions" />
       
        <CheckBox
            android:id="@+id/cbCrossDept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow CHECK OUT by scanning a different department's QR (not recommended)"
            android:textSize="15sp" />
        <Button
            android:id="@+id/btnSaveBehaviour"
            style="@style/AdminButton"
            android:text="Save behaviour" />

        <!-- Queue -->
        <TextView style="@style/AdminHeader" android:text="Offline queue" />
        <TextView
            android:id="@+id/tvQueue"
            style="@style/AdminBody" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSyncNow"
                style="@style/AdminButtonHalf"
                android:text="Sync now" />
            <Button
                android:id="@+id/btnClearFailed"
                style="@style/AdminButtonHalf"
                android:text="Clear failed" />
        </LinearLayout>

        <!-- Device readiness -->
        <TextView style="@style/AdminHeader" android:text="Device readiness" />
        <TextView
            android:id="@+id/tvPermissions"
            style="@style/AdminBody" />
        <Button
            android:id="@+id/btnOverlay"
            style="@style/AdminButton"
            android:text="Open 'Display over other apps'" />

        <TextView style="@style/AdminHeader" android:text="Security" />
        <Button
            android:id="@+id/btnChangePin"
            style="@style/AdminButton"
            android:text="Change admin PIN" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_primary"
            android:text="EXIT ADMIN"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
